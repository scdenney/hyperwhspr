[Unit]
Description=hyprwhspr stt
Documentation=https://github.com/goodroot/hyprwhspr
After=graphical-session.target pipewire.service ydotool.service
StartLimitIntervalSec=300
StartLimitBurst=5
Requires=ydotool.service
Wants=pipewire.service

[Service]
Type=simple
# Pass Wayland/X11 display env from the user session manager so wl-copy,
# wl-paste, and the GTK4 mic-osd overlay can connect to the compositor.
PassEnvironment=WAYLAND_DISPLAY DISPLAY
# Wait for Wayland compositor socket to appear before starting
ExecStartPre=/bin/bash -c 'for i in $(seq 1 30); do ls /run/user/$(id -u)/wayland-* >/dev/null 2>&1 && exit 0; sleep 0.5; done; echo "Warning: Wayland socket not found after 15s"'
# Wait for UWSM to export WAYLAND_DISPLAY into the systemd user environment.
# The socket may exist before UWSM calls import-environment, so PassEnvironment
# would pass an empty value without this guard, leaving subprocesses (mic-osd,
# wl-copy) unable to connect to the compositor.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do systemctl --user show-environment 2>/dev/null | grep -q "^WAYLAND_DISPLAY=" && exit 0; sleep 0.5; done; echo "Warning: WAYLAND_DISPLAY not found in session env after 30s"'
# Wait for DNS before starting when transcription goes over the network.
# hyprwhspr connects to the transcription endpoint once at startup; if it loses
# the race with DHCP/DNS it logs "Temporary failure in name resolution", marks
# the backend dead, and only retries on the next record attempt — so the first
# hotkey press after boot is spent reconnecting instead of recording. Skipped
# for local backends (onnx-asr, pywhispercpp). Change the host if you point the
# config at a provider other than OpenAI.
ExecStartPre=/bin/bash -c 'C=%h/.config/hyprwhspr/config.json; grep -q realtime-ws $C || grep -q rest-api $C || exit 0; for i in $(seq 1 60); do getent hosts api.openai.com >/dev/null 2>&1 && exit 0; sleep 0.5; done; echo "Warning: api.openai.com did not resolve after 30s"'
# Clean stale mic-osd PID file so the runner spawns a fresh daemon
# instead of trying to signal a PID that was reused by another process
ExecStartPre=/bin/rm -f %h/.config/hyprwhspr/mic_osd.pid
ExecStart=/usr/lib/hyprwhspr/bin/hyprwhspr
# Ensure virtual keyboard is killed even on crash/SIGKILL to release device grabs
ExecStopPost=/bin/bash -c 'pkill -9 -f "hyprwhspr-virtual-keyboard" 2>/dev/null || true'
Environment=HYPRWHSPR_ROOT=/usr/lib/hyprwhspr
Environment=PYTHONUNBUFFERED=1
# Optional: point cleanup.py at OpenAI or a local OpenAI-compatible server.
Environment=HYPRWHSPR_CLEANUP_MODEL=gpt-5.4-mini
Environment=HYPRWHSPR_LLM_API_URL=https://api.openai.com/v1/chat/completions
# Optional for local ONNX ASR with CUDA pip libraries. Replace YOUR_USER and
# python3.14 with the paths used by your hyprwhspr virtual environment.
# Environment=LD_LIBRARY_PATH=/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/cublas/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/cudnn/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/cufft/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/cuda_runtime/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/cuda_nvrtc/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/cusparse/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/cusolver/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/curand/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/nvjitlink/lib:/home/YOUR_USER/.local/share/hyprwhspr/venv/lib/python3.14/site-packages/nvidia/nccl/lib:/opt/cuda/lib64
Restart=on-failure
# Give kernel time to release device grabs after stop
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
